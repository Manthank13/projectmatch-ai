# ==========================================
# ProjectMatch Environment Configuration
# ==========================================

# 1. Supabase Client Configuration (Vite Frontend)
# Find in Supabase Dashboard -> Settings -> API -> Project URL & anon/public API Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# 2. Server-Side AI Configuration (Express Backend)
# Server-side only (never exposed to client browser)
GEMINI_API_KEY=your-gemini-api-key-here
PORT=3001
